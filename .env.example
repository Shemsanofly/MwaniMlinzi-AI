# ─── Server ───
# The app now runs as ONE Next.js process (pages + /api on the same origin).
# `npm run dev` and the background runner (`npm run start:local`) listen on MWANI_PORT (default 5173),
# read from the shell environment. PORT here in .env is NOT used to choose the port (kept for compatibility).
PORT=5000
# Decides the server mode, even under `next start` (which itself forces production): development | production
NODE_ENV=development
# Comma-separated list of allowed origins for OTHER sites calling the API from a browser.
# The app's own pages are same-origin now, so they do not need to be listed here.
CORS_ORIGIN=http://localhost:5173

# ─── Database (PostgreSQL, manage with pgAdmin) ───
# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:password@localhost:5432/mwanimlinzi

# ─── Auth ───
# REQUIRED: long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── First admin account (created by `npm run seed` when no admin exists) ───
ADMIN_EMAIL=admin@mwanimlinzi.local
# At least 12 characters. If empty, `npm run seed` generates one, prints it and saves it to ADMIN_CREDENTIALS.local.txt.
ADMIN_PASSWORD=

# ─── Scheduled jobs (node-cron) ───
ENABLE_JOBS=true

# ─── LLM (optional; only explains/translates approved recommendations) ───
# anthropic | openai  (empty = deterministic templates)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# ─── Weather (live) ───
# empty = open-meteo (free, no key) | openweathermap (needs WEATHER_API_KEY) | tma (reads TMA_BULLETIN_PATH) | none
WEATHER_PROVIDER=
WEATHER_API_KEY=
# TMA bulletin JSON file (regions keyed by Unguja/Pemba/default). Only used when WEATHER_PROVIDER=tma.
# Shape documented in src/providers/weatherProvider.js. Admin or an uploader cron drops it in daily.
TMA_BULLETIN_PATH=
TMA_BULLETIN_MAX_HOURS=24

# ─── Ocean (live) ───
# empty = open-meteo-marine (free, no key) | cmems / copernicus / copernicus-marine (CMEMS via Open-Meteo,
# free, no key) | stormglass (needs OCEAN_API_KEY) | none
OCEAN_PROVIDER=
OCEAN_API_KEY=

# ─── Optional LightGBM / XGBoost microservice ───
# Empty = use the built-in JS logistic baseline. See ai/ml-service/README.md to run the Python service.
ML_SERVICE_URL=
ML_SERVICE_TIMEOUT_MS=2500

# ─── Africa's Talking (SMS + USSD) ───
# Start with the sandbox: AT_USERNAME=sandbox, AT_ENVIRONMENT=sandbox and the sandbox API key
# (https://account.africastalking.com/apps/sandbox → Settings → API Key). Never commit real values.
AT_USERNAME=
AT_API_KEY=
# sandbox | production
AT_ENVIRONMENT=sandbox
# Optional alphanumeric sender ID / short code approved on your AT account (empty = AT default)
AT_SMS_SENDER_ID=
# The USSD code registered in AT (e.g. *384*123#). When set, callbacks for other codes are rejected.
AT_USSD_SERVICE_CODE=
# REQUIRED for USSD/SMS callbacks: long random string appended to every callback URL as ?secret=…
AT_CALLBACK_SECRET=
# Local/sandbox simulator only: lets /api/ussd/MwaniMlinzi work without ?secret=.
# Ignored when NODE_ENV=production. Keep false for live deployments.
AT_ALLOW_UNSIGNED_SANDBOX_USSD=false
# Sandbox development only. true = outbound SMS is short-circuited (no HTTP call to AT); every send is
# still logged in notification_logs and shown in Admin → Africa's Talking as QUEUED with a synthetic
# providerRef. Use it to develop or demo USSD→SMS flows when AT auth is not yet set up. Silently
# ignored when AT_ENVIRONMENT=production or NODE_ENV=production. Keep false for real delivery.
AT_SMS_DEV_CAPTURE=false
# Public HTTPS base URL of this API (used to show the callback URLs to admins), e.g. https://api.example.org
PUBLIC_API_URL=

# ─── Sarufi (WhatsApp gateway) ───
# Shared secret appended to the Sarufi webhook URL as ?secret=…; required to accept incoming WhatsApp messages.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SARUFI_WEBHOOK_SECRET=
# The WhatsApp Business number that hosts the bot (display only, e.g. Admin → Integrations).
SARUFI_BOT_PHONE=+255753790797

# ─── File uploads ───
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Reverse geocoding for the farmer form. Set 'none' to disable, or a Nominatim-compatible server URL.
# Public Nominatim requests are cached and limited to one per second per backend instance.
# Use a dedicated provider for deployments with multiple backend instances or substantial traffic.
GEOCODING_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=MwaniMlinzi-AI/1.0 (farm location lookup)

# Registered-email password recovery. SMTP_PASSWORD stays on the backend only.
# Port 587 uses STARTTLS; port 465 uses SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Browser API base; leave empty for same-origin /api
# Set only if the API lives on another origin, e.g. https://api.example.org/api
NEXT_PUBLIC_API_URL=


# ─── Voice-call AI assistant (inbound AT voice) ───
# STT: openai (Whisper) | google (Cloud Speech sw-TZ). Empty behaves like 'openai'.
VOICE_STT_PROVIDER=openai
VOICE_STT_LANG_HINT=sw
VOICE_STT_MAX_SECONDS=30
# Reused: LLM_API_KEY if LLM_PROVIDER=openai. Otherwise set a dedicated key:
VOICE_OPENAI_API_KEY=
GOOGLE_STT_API_KEY=

# TTS: google | elevenlabs | at_say (degraded <Say> fallback only). Empty = google.
VOICE_TTS_PROVIDER=google
VOICE_TTS_VOICE_SW=sw-KE-Standard-A
VOICE_TTS_VOICE_EN=en-US-Neural2-C
GOOGLE_TTS_API_KEY=
# Alternative: path to a service-account JSON for Google Cloud TTS:
GOOGLE_APPLICATION_CREDENTIALS=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Audio cache + HMAC-signed audio URLs (never leak the signing key)
VOICE_AUDIO_DIR=uploads/voice
VOICE_AUDIO_RETENTION_DAYS=7
VOICE_AUDIO_URL_EXPIRY_MINUTES=10

# Call budgets
VOICE_MAX_TURNS=10
VOICE_MAX_CALL_SECONDS=600
VOICE_PIPELINE_BUDGET_MS=15000
