# Base URL of the backend API. Leave empty locally to use Vite's /api proxy.
# In production set it to your API origin, e.g. https://api.example.org/api
VITE_API_URL=

# Backend address used by the local dev/preview proxy. Change this if the API uses another port.
VITE_PROXY_TARGET=http://127.0.0.1:5000
