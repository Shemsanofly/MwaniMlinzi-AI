# ─── Server ───
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# ─── Database (PostgreSQL, manage with pgAdmin) ───
# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:password@localhost:5432/mwanimlinzi

# ─── Auth ───
# REQUIRED: long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── Demo / live mode ───
# true  = always use demo (mock) environmental, SMS and USSD providers
# false = use live providers when configured, falling back to cached then demo data
DEMO_MODE=true
# Password for all seeded demo accounts. If empty, `npm run seed` generates one and prints it.
DEMO_PASSWORD=

# ─── Scheduled jobs (node-cron) ───
ENABLE_JOBS=true

# ─── LLM (optional; only explains/translates approved recommendations) ───
# anthropic | openai  (empty = deterministic templates)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# ─── Weather (live) ───
# open-meteo (free, no key) | openweathermap (needs WEATHER_API_KEY)
WEATHER_PROVIDER=
WEATHER_API_KEY=

# ─── Ocean (live) ───
# open-meteo-marine (free, no key) | stormglass (needs OCEAN_API_KEY)
OCEAN_PROVIDER=
OCEAN_API_KEY=

# ─── SMS / USSD gateways (live) ───
# africastalking (needs SMS_API_KEY + SMS_USERNAME) | empty = simulated
SMS_PROVIDER=
SMS_API_KEY=
SMS_USERNAME=
SMS_SENDER_ID=
USSD_PROVIDER=
USSD_API_KEY=

# ─── File uploads ───
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
