# ─── Server ───
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# ─── Database (PostgreSQL, manage with pgAdmin) ───
# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:password@localhost:5432/mwanimlinzi

# ─── Auth ───
# REQUIRED: long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── First admin account (created by `npm run seed` when no admin exists) ───
ADMIN_EMAIL=admin@mwanimlinzi.local
# At least 12 characters. If empty, `npm run seed` generates one, prints it and saves it to ADMIN_CREDENTIALS.local.txt.
ADMIN_PASSWORD=

# ─── Scheduled jobs (node-cron) ───
ENABLE_JOBS=true

# ─── LLM (optional; only explains/translates approved recommendations) ───
# anthropic | openai  (empty = deterministic templates)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# ─── Weather (live) ───
# empty = open-meteo (free, no key) | openweathermap (needs WEATHER_API_KEY) | none
WEATHER_PROVIDER=
WEATHER_API_KEY=

# ─── Ocean (live) ───
# empty = open-meteo-marine (free, no key) | stormglass (needs OCEAN_API_KEY) | none
OCEAN_PROVIDER=
OCEAN_API_KEY=

# ─── Africa's Talking (SMS + USSD) ───
# Start with the sandbox: AT_USERNAME=sandbox, AT_ENVIRONMENT=sandbox and the sandbox API key
# (https://account.africastalking.com/apps/sandbox → Settings → API Key). Never commit real values.
AT_USERNAME=
AT_API_KEY=
# sandbox | production
AT_ENVIRONMENT=sandbox
# Optional alphanumeric sender ID / short code approved on your AT account (empty = AT default)
AT_SMS_SENDER_ID=
# The USSD code registered in AT (e.g. *384*123#). When set, callbacks for other codes are rejected.
AT_USSD_SERVICE_CODE=
# REQUIRED for USSD/SMS callbacks: long random string appended to every callback URL as ?secret=…
AT_CALLBACK_SECRET=
# Local/sandbox simulator only: lets /api/ussd/MwaniMlinzi work without ?secret=.
# Ignored when NODE_ENV=production. Keep false for live deployments.
AT_ALLOW_UNSIGNED_SANDBOX_USSD=false
# Public HTTPS base URL of this API (used to show the callback URLs to admins), e.g. https://api.example.org
PUBLIC_API_URL=

# ─── File uploads ───
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
